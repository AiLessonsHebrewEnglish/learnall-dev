---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="English">
  <div class="page-wrap">
    <div class="page-hero">
      <div class="page-hero-inner">
        <div class="page-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M30 6 L36 14 L42 10 L36 20 L42 26 L36 30 L30 38"/>
            <path d="M18 6 L12 14 L6 10 L12 20 L6 26 L12 30 L18 38"/>
          </svg>
        </div>
        <h1>English</h1>
        <p class="lead">
          Reading, writing, grammar, vocabulary, and conversation — for native
          speakers sharpening their skills and learners building confidence.
        </p>
      </div>
    </div>

    <div class="modes">
      <div class="modes-grid">
        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h2>Self-paced</h2>
          <p>
            Readings, writing prompts, grammar drills, and vocabulary sets that
            adapt as you go. Mark what you know, revisit what you don't, and
            build a path that fits your level.
          </p>
        </article>

        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-4"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h2>With a tutor</h2>
          <p>
            Conversations, corrected writing, and focused practice on the parts
            that matter most to you — academic English, business communication,
            or everyday fluency.
          </p>
        </article>
      </div>
    </div>
  </div>
</Layout>
