---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="AI">
  <div class="page-wrap">
    <div class="page-hero">
      <div class="page-hero-inner">
        <div class="page-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="20" cy="20" r="8"/>
            <circle cx="28" cy="20" r="8"/>
            <path d="M23 28 L25 38 L23 38"/>
            <path d="M16 28 L20 34"/>
            <path d="M28 12 L34 18"/>
            <circle cx="36" cy="12" r="4" stroke-width="1.2"/>
          </svg>
        </div>
        <h1>AI</h1>
        <p class="lead">
          Machine learning, neural networks, data, and the practical side of
          working with AI — concepts, intuition, and hands-on application.
        </p>
      </div>
    </div>

    <div class="modes">
      <div class="modes-grid">
        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h2>Self-paced</h2>
          <p>
            Start with the core ideas — what models are, how they learn, and what
            they're good at — then move into building and using them yourself.
          </p>
        </article>

        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-4"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h2>With a tutor</h2>
          <p>
            Pair up to work through a project, debug a model, or understand a
            paper. A tutor turns a wall of math or jargon into something you can
            actually use.
          </p>
        </article>
      </div>
    </div>
  </div>
</Layout>
