---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Programming">
  <div class="page-wrap">
    <div class="page-hero">
      <div class="page-hero-inner">
        <div class="page-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 30 L14 18 L22 18 L22 12 L30 18 L30 30"/>
            <path d="M22 24 L22 20"/>
            <path d="M34 16 L42 22 L34 28"/>
          </svg>
        </div>
        <h1>Programming</h1>
        <p class="lead">
          From first program to real projects — Python, JavaScript, web
          development, algorithms, and the habits that make code maintainable.
        </p>
      </div>
    </div>

    <div class="modes">
      <div class="modes-grid">
        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </div>
          <h2>Self-paced</h2>
          <p>
            Lessons, exercises, and small projects that build on each other. Go
            at your pace, rerun the hard bits, and stack up a portfolio as you
            learn.
          </p>
        </article>

        <article class="mode-card">
          <div class="mode-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-4"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h2>With a tutor</h2>
          <p>
            Get unstuck faster, learn idiomatic patterns, and review real code
            with someone who can explain why one approach is better than another.
            Especially useful when you're moving from "it works" to "it's good."
          </p>
        </article>
      </div>
    </div>
  </div>
</Layout>
